TRS_OWNER_PASSWORD=change-me
TRS_APP_PASSWORD=change-me
TRS_READONLY_PASSWORD=change-me
SESSION_SECRET=change-me-long-random-string
# the first administrator is created in the browser at the first start (the "First start" page);
# alternatively (automation) set both lines: BOOTSTRAP_ADMIN_LOGIN=admin and BOOTSTRAP_ADMIN_PASSWORD=at-least-10-chars
# optional: automatic backups (container time is UTC)
#BACKUP_HOUR=02
#BACKUP_KEEP_DAYS=30
# interface language of the program and the scripts: ru or en (language.bat changes it)
#TRS_LANG=ru
# network access: 127.0.0.1 = this computer only (default), 0.0.0.0 = the local network (see lan-on.bat, docs/NETWORK.md)
#APP_BIND=127.0.0.1
#APP_PORT=8000
# encrypted access (profile https, certificates in ./certs): HTTPS_ONLY=1
